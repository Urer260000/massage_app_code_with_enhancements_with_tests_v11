# Copy to .env and fill in. Everything is optional for local testing.

PORT=3000
# NODE_ENV=production   # refuses to start without JWT_SECRET and MONGO_DB_URL

# JWT_SECRET=generate one with: python generateSecretKey.py
# MONGO_DB_URL=mongodb://localhost:27017/massage_app

# Spa settings
# SPA_TIMEZONE=America/New_York   # default: this computer's time zone
# SPA_OPEN_HOUR=10
# SPA_CLOSE_HOUR=20
# SPA_SLOT_MINUTES=30
# SPA_MIN_NOTICE_MINUTES=30
# SPA_MAX_DAYS_AHEAD=21
# SPA_CLOSED_WEEKDAYS=          # e.g. 1 for Mondays, 1,7 for Mondays and Sundays
# CANCEL_CUTOFF_HOURS=24
# SPA_ADDRESS=1920 Gatsby Lane, West Egg
# SPA_PHONE=(555) 019-2020
# SPA_EMAIL=hello@the20sspa.com

# Staff accounts
# ADMIN_EMAILS=you@example.com           # these emails become staff when they sign up
# ADMIN_EMAIL=admin@the20sspa.com        # demo staff login created at start (always in local mode)
# ADMIN_PASSWORD=choose-a-strong-one

# Email. Without SMTP_URL, emails are printed in this window instead.
# SMTP_URL=smtps://user:password@smtp.example.com
# MAIL_FROM=the20sspa <hello@the20sspa.com>

# Security
# CORS_ORIGINS=https://the20sspa.com    # comma-separated; empty allows any origin
# TRUST_PROXY=1                          # set when running behind a proxy / load balancer
# LOG_LEVEL=info
